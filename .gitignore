# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------
# Local build outputs and archives that must never be committed.
#
# The Firebase C++ SDK under .firebase_sdk is ~2GB, and its prebuilt
# libraries (firebase_firestore.lib and friends) reach 1.5GB each.
# GitHub rejects files over 100MB, so these would break the push.
# ---------------------------------------------------------------------
.firebase_sdk/
*.lib
*.dll
*.so
*.dylib
*.exe
*.zip
*.rar
*.7z
*.apk
*.aab

# Local secrets
.env
.env.*
!.env.example

# Tooling / platform caches
.gradle/
android/local.properties
android/.cxx/
**/.cxx/

